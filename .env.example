# Copy to .env and adjust. See the Configuration table in README.md.

# Model used for both classification and response generation.
# Provisional default: locked once the P1.5 benchmark runs (see docs/TODO.md).
OLLAMA_MODEL=llama3.2:3b

# Ollama daemon address. Use http://ollama:11434 under Docker Compose.
OLLAMA_HOST=http://localhost:11434

# Reserved for the tool-calling milestone. No refund actions are taken in the
# MVP, so this value has no effect yet.
REFUND_APPROVAL_THRESHOLD_USD=50

# Set to debug to see full classifier rationale output.
LOG_LEVEL=info
